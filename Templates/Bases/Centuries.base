filters:
  and:
    - list(categories).contains(link("Indianization Sources"))
    - note.century
    - '!file.name.contains("Template")'
    - '!file.name.contains("Timeline")'
properties:
  file.name:
    displayName: Century Folder
  note.phase:
    displayName: Phase
  note.century:
    displayName: Century
views:
  - type: table
    name: Centuries
    order:
      - file.name
      - century
      - phase
    sort:
      - property: century_num
        direction: ASC
