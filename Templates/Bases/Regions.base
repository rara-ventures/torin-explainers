filters:
  and:
    - file.path.contains("regions")
    - '!file.name.contains("Template")'
properties:
  note.region:
    displayName: Region
  note.indianized:
    displayName: Indianized
  file.name:
    displayName: Region
  file.path:
    displayName: Path
views:
  - type: table
    name: All Regions
    order:
      - note.region
      - note.indianized
      - file.name
  - type: cards
    name: Map
    order: []
