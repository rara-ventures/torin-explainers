filters:
  and:
    - or:
        - list(categories).contains(link("Champa"))
        - note.region.containsAny("Champa")
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Source
  note.century:
    displayName: Century
  note.vector:
    displayName: Vector
  note.religion:
    displayName: Religion
views:
  - type: table
    name: All Champa
    order:
      - file.name
      - century
      - vector
      - religion
    sort:
      - property: century_num
        direction: ASC
  - type: table
    name: By Vector
    filters:
      and:
        - list(vector).containsAny(this)
    order:
      - file.name
      - century
