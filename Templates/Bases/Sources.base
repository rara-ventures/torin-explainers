filters:
  and:
    - list(categories).contains(link("Indianization Sources"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Source
  note.century:
    displayName: Century
  note.phase:
    displayName: Phase
  note.region:
    displayName: Region
  note.vector:
    displayName: Vector
  note.created:
    displayName: Added
  note.status:
    displayName: Status
views:
  - type: table
    name: By Century
    order:
      - file.name
      - century
      - phase
      - region
      - vector
      - status
    sort:
      - property: century_num
        direction: ASC
  - type: table
    name: Champa → Indonesia
    filters:
      and:
        - or:
            - note.region.containsAny("Champa")
            - note.region.containsAny("Sailendra Mataram")
            - note.region.containsAny("Srivijaya", "Kedah Srivijaya")
        - note.vector.containsAny("Buddhism")
    order:
      - file.name
      - century
      - region
  - type: cards
    name: Cards
    order: []
